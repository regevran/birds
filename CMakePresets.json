{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja (development)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BIRDS_BOOK_OUT": "${sourceDir}/book/out"
      }
    },
    {
      "name": "release",
      "displayName": "Ninja (release)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "help",
      "configurePreset": "default",
      "targets": ["usage"]
    },
    {
      "name": "data-build",
      "configurePreset": "default",
      "targets": ["data-build"]
    },
    {
      "name": "data-install",
      "configurePreset": "default",
      "targets": ["data-install"]
    },
    {
      "name": "data-test",
      "configurePreset": "default",
      "targets": ["data-test"]
    },
    {
      "name": "book-build",
      "configurePreset": "default",
      "targets": ["book-build"]
    },
    {
      "name": "book-install",
      "configurePreset": "default",
      "targets": ["book-install"]
    },
    {
      "name": "learn-test",
      "configurePreset": "default",
      "targets": ["learn-test"]
    },
    {
      "name": "learn-run",
      "configurePreset": "default",
      "targets": ["learn-run"]
    }
  ],
  "workflowPresets": [
    {
      "name": "data",
      "displayName": "Data: build, test, install",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "data-build"
        },
        {
          "type": "build",
          "name": "data-test"
        },
        {
          "type": "build",
          "name": "data-install"
        }
      ]
    },
    {
      "name": "book",
      "displayName": "Book: build, install",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "book-build"
        },
        {
          "type": "build",
          "name": "book-install"
        }
      ]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
