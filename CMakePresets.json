{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja (development)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BIRDS_BOOK_OUT": "${sourceDir}/book/out"
      }
    },
    {
      "name": "release",
      "displayName": "Ninja (release)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "data",
      "configurePreset": "default",
      "targets": ["data"]
    },
    {
      "name": "install-data",
      "configurePreset": "default",
      "targets": ["install-data"]
    },
    {
      "name": "test-data",
      "configurePreset": "default",
      "targets": ["test-data"]
    },
    {
      "name": "book",
      "configurePreset": "default",
      "targets": ["book"]
    },
    {
      "name": "install-book",
      "configurePreset": "default",
      "targets": ["install-book"]
    },
    {
      "name": "test-learn",
      "configurePreset": "default",
      "targets": ["test-learn"]
    },
    {
      "name": "run-learn",
      "configurePreset": "default",
      "targets": ["run-learn"]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
